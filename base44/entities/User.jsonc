{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "banned": {
      "type": "boolean",
      "description": "Whether this user is banned from the marketplace",
      "default": false
    },
    "display_name": {
      "type": "string",
      "description": "Optional public display name chosen by the user",
      "maxLength": 100
    },
    "phone": {
      "type": "string",
      "description": "Optional contact phone number provided by the user",
      "maxLength": 30
    },
    "profile_images": {
      "type": "array",
      "description": "Up to five profile photos selected by the account owner",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "role"
  ]
}