{
  "name": "Order",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to the product"
    },
    "product_title": {
      "type": "string",
      "description": "Product title snapshot"
    },
    "product_image": {
      "type": "string",
      "description": "Product image snapshot"
    },
    "price": {
      "type": "number",
      "description": "Price paid in GBP"
    },
    "commission": {
      "type": "number",
      "description": "10% commission amount"
    },
    "seller_payout": {
      "type": "number",
      "description": "Amount seller receives (90%)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Buyer email"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller email"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "shipped",
        "delivered",
        "completed",
        "refunded",
        "disputed"
      ],
      "default": "pending_payment",
      "description": "Order status"
    },
    "shipping_address": {
      "type": "string",
      "description": "Buyer shipping address"
    },
    "tracking_number": {
      "type": "string",
      "description": "Courier tracking number without carrier prefix"
    },
    "carrier": {
      "type": "string",
      "enum": [
        "Royal Mail",
        "Evri"
      ],
      "description": "Delivery carrier selected by the seller"
    },
    "shipped_at": {
      "type": "date-time",
      "description": "Timestamp when the seller first marked the order shipped"
    },
    "tracking_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_transit",
        "delivered",
        "exception",
        "unknown"
      ],
      "default": "not_started",
      "description": "Latest carrier delivery status recorded by UKMarketStore"
    },
    "last_tracking_check": {
      "type": "date-time",
      "description": "Last successful carrier status check"
    },
    "delivered_at": {
      "type": "date-time",
      "description": "Timestamp when the carrier confirmed delivery"
    },
    "shipping_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the buyer has already been sent the 'your order has shipped' email (dedup)"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID (for refunds)"
    },
    "transfer_id": {
      "type": "string",
      "description": "Stripe Transfer ID (seller payout)"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this order",
      "maxLength": 1000
    },
    "client_ip": {
      "type": "string",
      "description": "Caller IP captured at checkout, used for un-spoofable abuse throttling and fraud audit. Never shown to buyers."
    },
    "size": {
      "type": "string",
      "description": "Selected size variation, when the listing offered sizes."
    },
    "colour": {
      "type": "string",
      "description": "Selected colour variation, when the listing offered colours."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantity purchased for this variation."
    },
    "checkout_source": {
      "type": "string",
      "enum": [
        "basket",
        "single"
      ],
      "description": "Which checkout flow created this order. Basket orders had available_quantity and variation_stock deducted on payment, so a refund must restore them. Legacy orders without this field keep the original refund behaviour."
    }
  },
  "required": [
    "product_id",
    "product_title",
    "price",
    "buyer_email",
    "seller_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}