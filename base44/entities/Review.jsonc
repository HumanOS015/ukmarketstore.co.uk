{
  "name": "Review",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to the order"
    },
    "product_id": {
      "type": "string",
      "description": "Reference to the product"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller email being reviewed"
    },
    "buyer_email": {
      "type": "string",
      "description": "Reviewer email"
    },
    "rating": {
      "type": "number",
      "description": "Rating from 1 to 5",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "description": "Review comment",
      "maxLength": 500
    }
  },
  "required": [
    "order_id",
    "product_id",
    "seller_email",
    "buyer_email",
    "rating"
  ],
  "rls": {
    "create": {
      "data.buyer_email": "{{user.email}}"
    },
    "update": {
      "data.buyer_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}