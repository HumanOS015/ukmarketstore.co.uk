{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Price in GBP"
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics",
        "Fashion",
        "Home & Garden",
        "Sports",
        "Toys",
        "Motors",
        "Books",
        "Music",
        "Collectibles",
        "Health & Beauty",
        "Pet Supplies",
        "Other"
      ],
      "description": "Product category"
    },
    "postcode": {
      "type": "string",
      "description": "UK postcode for item location"
    },
    "image_url": {
      "type": "string",
      "description": "Main product image URL"
    },
    "additional_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra product image URLs (max 4)"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller email"
    },
    "seller_name": {
      "type": "string",
      "description": "Seller display name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_stripe",
        "active",
        "sold",
        "removed"
      ],
      "default": "active",
      "description": "Listing status. Pending Stripe means saved but not purchasable until seller payout setup is complete."
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Used - Like New",
        "Used - Fair"
      ],
      "description": "Item condition"
    },
    "fulfilment_method": {
      "type": "string",
      "enum": [
        "Tracked UK Delivery"
      ],
      "description": "How the item will be delivered"
    },
    "estimated_delivery": {
      "type": "string",
      "description": "Estimated delivery time"
    },
    "inventory_ref": {
      "type": "string",
      "description": "Unique internal inventory/stock reference for multi-marketplace sync. Optional; generated/assigned when a listing enters the inventory protection system."
    },
    "sku": {
      "type": "string",
      "description": "Seller-defined stock keeping unit, used as a stable identifier for external listing matching."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Total physical quantity of this listing. Single-item listings are 1."
    },
    "available_quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantity still available to sell across all marketplaces. Set to 0 when the item sells anywhere."
    },
    "inventory_sync_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "pending_external_sync",
        "synced",
        "failed_external_sync"
      ],
      "default": "not_connected",
      "description": "Current state of this listing's inventory synchronisation with external marketplaces."
    },
    "last_sync_time": {
      "type": "date-time",
      "description": "Timestamp of the last synchronisation attempt (success or failure)."
    },
    "last_successful_sync_time": {
      "type": "date-time",
      "description": "Timestamp of the last successful synchronisation."
    },
    "sync_error_state": {
      "type": "string",
      "enum": [
        "none",
        "error",
        "unmatched"
      ],
      "default": "none",
      "description": "Synchronisation error state for this listing."
    },
    "sync_error_message": {
      "type": "string",
      "description": "Human-readable synchronisation error message, if any."
    },
    "sold_elsewhere": {
      "type": "boolean",
      "default": false,
      "description": "True when this physical item was sold on an external marketplace, triggering inventory protection."
    },
    "sold_elsewhere_marketplace": {
      "type": "string",
      "enum": [
        "eBay",
        "Amazon",
        "Vinted",
        "Other"
      ],
      "description": "External marketplace where this item sold, when sold_elsewhere is true."
    },
    "sold_elsewhere_timestamp": {
      "type": "date-time",
      "description": "When the external sale was detected/recorded."
    },
    "sync_locked": {
      "type": "boolean",
      "default": false,
      "description": "Soft inventory lock held while an availability mutation is in progress. While true the listing is not purchasable."
    },
    "manual_override": {
      "type": "boolean",
      "default": false,
      "description": "True when a seller has manually overridden the inventory state (e.g. forced availability)."
    },
    "size_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this listing offers size variations that the buyer must select."
    },
    "size_type": {
      "type": "string",
      "enum": [
        "clothing",
        "shoe",
        "custom"
      ],
      "description": "The kind of size options offered, which determines the default size presets shown to the seller."
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The sizes the seller has configured for this listing, e.g. [\"S\",\"M\",\"L\"]."
    },
    "colour_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this listing offers colour variations the buyer may select."
    },
    "colours": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Colour names the seller has configured, e.g. [\"Black\",\"Navy\"]."
    },
    "variation_stock": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string",
            "description": "Size this stock entry applies to, or empty for size-independent."
          },
          "colour": {
            "type": "string",
            "description": "Colour this stock entry applies to, or empty for colour-independent."
          },
          "quantity": {
            "type": "number",
            "description": "Stock available for this specific size/colour combination."
          }
        },
        "required": [
          "quantity"
        ]
      },
      "description": "Optional per-variation stock. When an entry matches the buyer's selected size+colour it overrides the product-level available_quantity; otherwise the product-level stock is used."
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "postcode",
    "image_url",
    "seller_email",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.seller_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}