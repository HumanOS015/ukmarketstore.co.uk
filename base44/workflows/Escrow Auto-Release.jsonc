{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "escrow_auto_release",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "release_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoReleaseEscrow",
            "args": {
              "internal_call": "escrow_release"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Release eligible escrows",
            "description": "Shipped 14+ days, or delivered pending payout"
          }
        }
      }
    ]
  },
  "description": "Releases escrow funds to sellers 14 days after an order ships (if the buyer hasn't confirmed delivery), and retries payouts for delivered orders where the earlier transfer failed",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Escrow Auto-Release"
}