{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Price in GBP"
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics",
        "Fashion",
        "Home & Garden",
        "Sports",
        "Toys",
        "Motors",
        "Books",
        "Music",
        "Collectibles",
        "Health & Beauty",
        "Pet Supplies",
        "Other"
      ],
      "description": "Product category"
    },
    "postcode": {
      "type": "string",
      "description": "UK postcode for item location"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller email"
    },
    "seller_name": {
      "type": "string",
      "description": "Seller display name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "removed"
      ],
      "default": "active",
      "description": "Listing status"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Used - Like New",
        "Used - Fair"
      ],
      "description": "Item condition"
    },
    "fulfilment_method": {
      "type": "string",
      "enum": [
        "Tracked UK Delivery"
      ],
      "description": "How the item will be delivered"
    },
    "estimated_delivery": {
      "type": "string",
      "description": "Estimated delivery time"
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "postcode",
    "image_url",
    "seller_email",
    "status"
  ],
  "rls": {
    "create": {
      "data.seller_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}